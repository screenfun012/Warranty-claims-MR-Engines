// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite doesn't support enums, using String with @default instead

model User {
  id              String   @id @default(cuid())
  fullName        String?  // Made optional for OAuth users
  email           String   @unique
  password        String?  // Heširana lozinka (opciono za OAuth korisnike)
  role            String @default("VIEWER") // SUPER_ADMIN, ADMIN, MANAGER, OPERATOR, TECHNICIAN, WORKER, VIEWER
  emailVerified   DateTime?
  emailVerificationToken String? // 6-cifreni token za verifikaciju emaila
  emailVerificationTokenExpires DateTime? // Token expiration time
  active          Boolean  @default(true) // Za deaktivaciju korisnika
  approved        Boolean  @default(false) // Korisnik mora biti odobren od SUPER_ADMIN pre pristupa
  // NextAuth adapter fields
  accounts        Account[]
  sessions        Session[]
  // Existing relations
  claimsAssigned  Claim[]  @relation("ClaimAssignedTo")
  workOrders      WorkOrder[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token       String   @unique
  expires     DateTime

  @@unique([identifier, token])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  company   String?  // Customer company name
  email     String?
  country   String?
  notes     String?
  claims    Claim[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkOrder {
  id            String   @id @default(cuid())
  workOrderCode String   @unique
  engineType    String?
  mrEngineCode  String?
  workerId      String?
  worker        User?    @relation(fields: [workerId], references: [id])
  assemblyDate  DateTime?
  nasFolderPath String?
  claims        Claim[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Claim {
  id                   String          @id @default(cuid())
  claimCodeRaw         String?
  claimPrefix          String?         // Deprecated - kept for backward compatibility
  claimNumber          Int?
  claimYear            Int?
  status               String          @default("NEW") // NEW, IN_ANALYSIS, APPROVED, REJECTED, CLOSED
  claimAcceptanceStatus String?        // ACCEPTED, REJECTED, PENDING
  processingEmailSentAt DateTime?      // Kada je poslat email o obradi reklamacije
  isLocked             Boolean         @default(false) // If true, claim is locked (read-only for non-SUPER_ADMIN users)
  customerId           String?
  customer             Customer?       @relation(fields: [customerId], references: [id])
  workOrderId          String?
  workOrder            WorkOrder?      @relation(fields: [workOrderId], references: [id])
  engineType           String?
  mrEngineCode         String?
  customerReference    String?
  invoiceNumber        String?
  assignedToId         String?        // Ko je radio motor (ne ko je radio reklamaciju)
  assignedTo           User?           @relation("ClaimAssignedTo", fields: [assignedToId], references: [id])
  faultDepartmentId    String?        // Odeljenje gde je nastao problem
  faultDepartment      Department?    @relation(fields: [faultDepartmentId], references: [id])
  workerFault          String?        // Koji radnik je kriv
  yearEngineDone       Int?           // Godina kada je motor bio sklopljen
  reason               String?        // Kratak razlog zašto je došlo do reklamacije
  isDomesticMarket     Boolean        @default(false) // Da li je domaće ili strano tržište
  serverFolderPath     String?
  summarySr            String?
  summaryEn            String?
  summaryDe            String? // German (Beta)
  summaryFr            String? // French (Beta)
  summaryNl            String? // Dutch (Beta)
  emailThreads         EmailThread[]
  attachments          Attachment[]
  clientDocuments      ClientDocument[]
  photos               Photo[]
  reportSections       ReportSection[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model EmailThread {
  id              String        @id @default(cuid())
  claimId         String?
  claim           Claim?        @relation(fields: [claimId], references: [id])
  subjectOriginal String
  originalSender  String?
  forwardedBy     String?
  viewedAt        DateTime?     // When the thread was last viewed/opened
  messages        EmailMessage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailMessage {
  id             String       @id @default(cuid())
  emailThreadId  String
  emailThread    EmailThread  @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  direction      String // INBOUND, OUTBOUND
  from           String
  to             String
  cc             String?
  subject        String
  bodyText       String?
  bodyHtml       String?
  messageId      String?
  inReplyTo      String?
  date           DateTime
  rawSourcePath  String?
  attachments    Attachment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Attachment {
  id             String        @id @default(cuid())
  emailMessageId String?
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  claimId        String?
  claim          Claim?        @relation(fields: [claimId], references: [id])
  fileName       String
  mimeType       String
  filePath       String
  isInline       Boolean @default(false)
  isProbablyLogo Boolean @default(false)
  isRelevant     Boolean @default(true)
  source         String @default("CLIENT") // CLIENT, INTERNAL_TEARDOWN, OTHER
  textOriginal   String? // Extracted text from PDF
  textSr         String? // Serbian translation
  textEn         String? // English translation
  clientDocument ClientDocument?
  photo          Photo?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClientDocument {
  id               String   @id @default(cuid())
  claimId          String
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  attachmentId     String?  @unique
  attachment       Attachment? @relation(fields: [attachmentId], references: [id])
  originalLanguage String?
  detectedLanguage String?
  textOriginal     String
  textSr           String?
  textEn           String?
  documentType     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Photo {
  id            String      @id @default(cuid())
  claimId       String
  claim         Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  attachmentId  String?     @unique
  attachment    Attachment? @relation(fields: [attachmentId], references: [id])
  internalUpload Boolean  @default(false)
  indexNo       Int?
  groupLabel    String?
  captionSr     String?
  captionEn     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReportSection {
  id          String         @id @default(cuid())
  claimId     String
  claim       Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sectionType String // IDENTIFICATION, GENERAL, FINDINGS, EXPLANATION, CONCLUSION, OTHER
  orderIndex  Int
  textSr      String?
  textEn      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MailSyncState {
  id          String   @id @default("default")
  lastUid     String?
  lastSyncedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Track deleted email messages to prevent them from being recreated during sync
model DeletedEmailMessage {
  id        String   @id @default(cuid())
  messageId String   @unique // Email messageId - unique identifier
  threadId  String?  // Original thread ID (for reference)
  deletedAt DateTime @default(now())
  deletedBy String?  // User who deleted it (optional)
  
  @@index([messageId])
}

// Department model for fault departments (odeljenja)
model Department {
  id          String   @id @default(cuid())
  name        String   @unique // Name of the department (e.g., "Blokovi", "Klipnjace")
  isSystem    Boolean  @default(false) // System departments cannot be deleted
  claims      Claim[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
